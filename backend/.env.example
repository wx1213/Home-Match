# ============== HomeMatch 后端环境变量示例 ==============
# 复制为 .env 并填入真实值
# .env 加入 .gitignore，绝不入库

# === 运行模式 ===
APP_ENV=development              # development | staging | production
APP_DEBUG=true                   # true | false
APP_NAME=HomeMatch
APP_VERSION=0.1.0

# === 服务 ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

# === 日志 ===
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# === PostgreSQL ===
DATABASE_URL=postgresql://homa:devpass@localhost:5432/homa
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false               # SQL 打印（开发可开）

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
JWT_SECRET=change-me-to-a-very-long-random-string-please-32+chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120       # 2h
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30          # 30d

# === 加密（手机号 AES）===
PHONE_ENCRYPTION_KEY=base64:change-me-to-a-32-byte-base64-encoded-key==
PHONE_HASH_KEY=change-me-to-another-random-string-for-hmac

# === 短信（阿里云）===
SMS_PROVIDER=aliyun              # aliyun | mock
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=HomeMatch
SMS_TEMPLATE_CODE=SMS_123456789
# 开发模式（不真发短信）
SMS_MOCK_CODE=1234               # 测试时所有验证码都是这个

# === 微信登录（v0.4：微信为主）===
WECHAT_APP_ID=                    # 正式 AppID（资质到位后填）
WECHAT_APP_SECRET=
WECHAT_TEST_APP_ID=               # 测试号 AppID（开发时用）
WECHAT_TEST_APP_SECRET=

# === Apple 登录（iOS 上架合规）===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/apple_key.p8

# === 推送（Firebase / APNs）===
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=./secrets/apns_key.p8
APNS_BUNDLE_ID=cn.hmatch.app

# === OSS（阿里云）===
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=hmatch-dev
OSS_STS_ROLE_ARN=

# === LLM ===
LLM_PROVIDER=deepseek             # deepseek | claude | openai
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_SOFT_CAP=2000                 # ¥/月
LLM_HARD_CAP=5000                 # ¥/月

# === Sentry ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# === 限流 ===
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH_SMS=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
