# ============================================================
#  HomeMatch Backend .env.production.example (Sprint2-#9)
# ============================================================
#
# 用途：生产环境部署模板（与 .env.example / .env 区分）
#
# 流程：
#   1. 复制为 .env.production
#      cp .env.production.example .env.production
#   2. 把所有 __REPLACE_ME__ 替换为真实值（用 secret 管理服务生成）
#   3. docker compose --profile prod --env-file .env.production up -d
#
# 注意：
#   - .env.production 加入 .gitignore（绝不提交）
#   - 所有密码 / 密钥用 32+ 字符随机（openssl rand -base64 32 生成）
#   - JWT_SECRET / PHONE_ENCRYPTION_KEY / PHONE_HASH_KEY 一旦泄漏
#     会让所有用户的 token 失效或手机号解密 → 立即轮换 + 通知全量用户

# === 运行模式 ===
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://api.homematch.com

# === 服务 ===
APP_HOST=0.0.0.0
APP_PORT=8000

# === CORS（仅生产域名）===
CORS_ORIGINS=https://homematch.com,https://www.homematch.com,https://admin.homematch.com

# === PostgreSQL ===
# 生产建议用云 RDS（阿里云 RDS-PG / AWS RDS），不用 docker
# DATABASE_URL 由 secret 注入；这里只是 fallback
DATABASE_URL=postgresql://homa:__REPLACE_ME__@rds-host.cn-beijing.rds.aliyuncs.com:5432/homa
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# === Redis ===
# 生产建议用云 Redis（阿里云 Redis / AWS ElastiCache）
REDIS_URL=redis://:__REPLACE_ME__@redis-host.cn-beijing.rds.aliyuncs.com:6379/0

# === JWT ===
JWT_SECRET=__RANDOM_32_CHARS_AT_LEAST__
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === 加密 ===
PHONE_ENCRYPTION_KEY=base64:__BASE64_OF_32_RANDOM_BYTES__
PHONE_HASH_KEY=__ANOTHER_RANDOM_32_CHARS__

# === 短信（阿里云）===
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=__ALIYUN_AK__
SMS_ACCESS_KEY_SECRET=__ALIYUN_SK__
SMS_SIGN_NAME=HomeMatch
SMS_TEMPLATE_CODE=SMS_REAL_TEMPLATE_CODE

# === 微信登录（[Sprint1-P0] 生产必填）===
WECHAT_APP_ID=__WECHAT_PROD_APP_ID__
WECHAT_APP_SECRET=__WECHAT_PROD_APP_SECRET__

# === Apple 登录 ===
APPLE_CLIENT_ID=cn.hmatch.app
APPLE_TEAM_ID=__APPLE_TEAM_ID__
APPLE_KEY_ID=__APPLE_KEY_ID__
APPLE_PRIVATE_KEY_PATH=/app/secrets/apple_key.p8

# === 推送 ===
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
APNS_KEY_ID=__APNS_KEY_ID__
APNS_TEAM_ID=__APNS_TEAM_ID__
APNS_KEY_PATH=/app/secrets/apns_key.p8
APNS_BUNDLE_ID=cn.hmatch.app

# === OSS（[Sprint1-P0] 正式接入）===
OSS_ACCESS_KEY_ID=__OSS_AK__
OSS_ACCESS_KEY_SECRET=__OSS_SK__
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=hmatch-prod
OSS_STS_ROLE_ARN=
UPLOAD_CDN_BASE=https://cdn.homematch.com
UPLOAD_MODE=oss

# === 上传 ===
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=/app/uploads

# === LLM ===
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_SOFT_CAP=2000
LLM_HARD_CAP=5000

# === Sentry（[Sprint2-#11]）===
SENTRY_DSN=https://__KEY__@sentry.io/__PROJ__
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# === 限流 ===
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH_SMS=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute

# === docker-compose 用 ===
BACKEND_TAG=__GIT_SHA__
BACKEND_PORT=8000
