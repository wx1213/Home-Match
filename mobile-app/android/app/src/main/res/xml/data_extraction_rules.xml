<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Android 12+ Data Extraction Rules (Sprint3-#14)
     https://developer.android.com/about/versions/12/backup-restore

     Google Play 强制要求此文件说明 APP 数据如何 backup / transfer。
     关键点：JWT token 不能被备份到 Google Drive（用户换机登出时安全）
     ============================================================ -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="flutter_secure_storage.xml"/>
        <exclude domain="database" path="flutter_secure_storage"/>
        <exclude domain="file" path="flutter_secure_storage"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flutter_secure_storage.xml"/>
        <exclude domain="database" path="flutter_secure_storage"/>
        <exclude domain="file" path="flutter_secure_storage"/>
    </device-transfer>
</data-extraction-rules>
